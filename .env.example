# Fikisha — environment template (Phase 2A foundation)
# Copy to `.env` and fill in local values. NEVER commit `.env`.
# This file contains variable NAMES and safe non-secret defaults only.

# ─── Django core ────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate for local dev: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-not-a-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_LANGUAGE_CODE=en

# ─── Database (PostgreSQL) ─────────────────────────────────────────────
POSTGRES_DB=fikisha
POSTGRES_USER=fikisha
POSTGRES_PASSWORD=fikisha-local-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port mapping used by docker-compose (kept off the default to avoid clashes)
POSTGRES_HOST_PORT=5433
# Optional: full URL overrides the parts above
# DATABASE_URL=postgres://fikisha:fikisha-local-dev@db:5432/fikisha

# ─── Redis / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
REDIS_HOST_PORT=6380
OUTBOX_POLL_SECONDS=3

# ─── API / CORS ───────────────────────────────────────────────────────
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# ─── Authentication / OTP ─────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_PER_HOUR=5
OTP_REQUEST_RATE_PER_MINUTE=1
# DEV ONLY: expose the OTP code in the request response + logs so devs can log in
# without an SMS provider. MUST be false in production (prod settings force it off).
OTP_DEV_EXPOSE=true
# DEV ONLY: if set, every OTP challenge accepts this fixed code (used by automated
# tests / demos). Leave blank to require the generated code.
OTP_DEV_FIXED_CODE=

# Session / token lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ADMIN_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_NAME=fikisha_refresh

# ─── Object storage abstraction ──────────────────────────────────────
# Phase 2A: local private filesystem backend by default. S3 backend is an
# interface stub — do not point at production storage yet.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/private_media
STORAGE_SIGNED_URL_TTL_SECONDS=120
# S3 (unused in 2A unless STORAGE_BACKEND=s3):
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Observability ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
# Error tracking (Sentry/GlitchTip) — not wired in 2A
SENTRY_DSN=

# ─── Frontend (Vite) — prefixed VITE_ to be exposed to the browser ───
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Fikisha
VITE_DEFAULT_LOCALE=en
VITE_ENABLE_PWA=true
